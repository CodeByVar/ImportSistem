{
  "name": "siscontrol",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,VITE\" -c \"blue,green\" \"node --watch server/index.js\" \"vite --host\"",
    "start": "node server/index.js",
    "start:prod": "npm run build && node server/index.js",
    "server": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "clean:test-data": "node server/cleanTestData.js",
    "migrate:uyus": "node server/migrateSheets.js uyus",
    "migrate:varios": "node server/migrateSheets.js varios",
    "migrate:all": "node server/migrateSheets.js all",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.68.0",
    "papaparse": "^5.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
